{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PharmaCare",
  "version": "0.1.0",
  "identifier": "com.pharmacare.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PharmaCare - Medical Store Management System",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/icon.png"
    ]
  }
}
