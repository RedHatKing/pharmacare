{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "default",
  "description": "Default Tauri capabilities for PharmaCare on Windows",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-mkdir",
    "fs:allow-exists"
  ],
  "scope": {
    "allow": [
      "E:/**",
      "D:/**",
      "C:/**",
      "$APPDATA/**",
      "$DOCUMENT/**",
      "$HOME/**"
    ]
  }
}
